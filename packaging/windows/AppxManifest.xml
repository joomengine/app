<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap5 rescap">
  <Identity Name="org.joomengine.app" Publisher="CN=JoomEngine" Version="0.1.0.0" ProcessorArchitecture="x64"/>
  <Properties>
    <DisplayName>JoomEngine</DisplayName>
    <PublisherDisplayName>JoomEngine</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-us"/>
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19045.0" MaxVersionTested="10.0.26100.0"/>
  </Dependencies>
  <Applications>
    <Application Id="JoomEngine" Executable="JoomEngine.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="JoomEngine" Description="Joomla Component Builder in JoomEngine Playground"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Tile.png" Square44x44Logo="Assets\AppList.png"/>
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="JoomEngine.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="joomengine.exe"/>
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>
  </Capabilities>
</Package>
